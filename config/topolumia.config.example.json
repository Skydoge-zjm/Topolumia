{
  "server": {
    "host": "127.0.0.1",
    "port": 5510
  },
  "frontend": {
    "host": "127.0.0.1",
    "port": 5610,
    "apiUrl": "http://127.0.0.1:5510"
  },
  "project": {
    "id": "diffusion-sr-reproduction",
    "name": "DiffusionSR Reproduction"
  },
  "researchEnvironment": {
    "kind": "default",
    "prefix": "",
    "pythonCommand": "python"
  },
  "sourceRefresh": {
    "enabled": true,
    "intervalMs": 60000,
    "freshForMs": 15000,
    "foregroundThresholdMs": 30000
  },
  "filesystem": {
    "roots": [
      "fixtures/research"
    ],
    "maxFiles": 80,
    "maxDepth": 4,
    "maxTextBytes": 65536,
    "excerptChars": 1800
  },
  "mlflow": {
    "baseUrl": "",
    "experimentId": "",
    "experimentName": "diffusion-sr-reproduction",
    "tokenEnv": "MLFLOW_TRACKING_TOKEN",
    "pageSize": 200,
    "maxRuns": 1000
  },
  "wandb": {
    "baseUrl": "",
    "graphqlPath": "/graphql",
    "authScheme": "basic",
    "entity": "your-entity",
    "project": "diffusion-sr-reproduction",
    "tokenEnv": "WANDB_API_KEY"
  },
  "tensorboard": {
    "logdir": "",
    "pythonCommand": "python"
  },
  "experimentRecords": {
    "pythonCommand": "python"
  },
  "docker": {
    "executionEnabled": false
  },
  "agentSessions": {
    "maxSessions": 50,
    "maxEventsPerSession": 1000,
    "profiles": [
      {
        "id": "codex-acp",
        "label": "Codex",
        "provider": "codex",
        "driver": "codex-app-server",
        "command": "codex",
        "args": [
          "app-server",
          "--listen",
          "stdio://"
        ],
        "versionArgs": [
          "--version"
        ],
        "minVersion": "0.147.0",
        "authProbe": {
          "kind": "codex",
          "args": [
            "login",
            "status"
          ]
        },
        "approvalPolicy": "on-request",
        "sandbox": "workspace-write"
      },
      {
        "id": "claude-agent-acp",
        "label": "Claude Code",
        "provider": "claude",
        "driver": "claude-cli-stream",
        "command": "claude",
        "versionArgs": [
          "--version"
        ],
        "authProbe": {
          "kind": "claude",
          "args": [
            "auth",
            "status",
            "--json"
          ]
        }
      },
      {
        "id": "opencode-v2",
        "label": "OpenCode 2",
        "provider": "opencode",
        "driver": "opencode-server-v2",
        "command": "opencode",
        "args": [
          "serve"
        ],
        "versionArgs": [
          "--version"
        ],
        "minVersion": "2.2.7",
        "maxVersion": "3.0.0",
        "requireVersion": true,
        "approvalPolicy": "on-request"
      },
      {
        "id": "opencode-acp",
        "label": "OpenCode 1（旧版）",
        "provider": "opencode",
        "driver": "opencode-server-v1",
        "command": "opencode",
        "args": [
          "serve"
        ],
        "versionArgs": [
          "--version"
        ],
        "minVersion": "1.19.0",
        "maxVersion": "2.0.0",
        "requireVersion": true,
        "approvalPolicy": "on-request"
      }
    ]
  }
}
