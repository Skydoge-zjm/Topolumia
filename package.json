{
  "name": "topolumia",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A local-first research workbench for agent sessions, research context and human-reviewed changes.",
  "scripts": {
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "node scripts/build/clean-backend.mjs && tsc -p tsconfig.backend.json && node dist/scripts/build/copy-backend-assets.js",
    "start": "node dist/src/server.js",
    "topolumia": "node dist/src/cli.js",
    "test": "npm run build:backend && node scripts/testing/run-backend-tests.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:release": "node --test scripts/release/export-source.test.mjs",
    "docs:check": "node scripts/documentation/check-docs.mjs",
    "test:docs": "node --test scripts/documentation/check-docs.test.mjs",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "evaluate:context": "npm run build:backend && node dist/scripts/diagnostics/evaluate-research-context.js",
    "setup:experiment-test-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/integration/setup-experiment-test-env.ps1",
    "test:experiment-integration": "npm run build:backend && node --test dist/tests/experiments/experiment-tracking.integration.js",
    "test:experiment-records-integration": "npm run build:backend && node --test dist/tests/research/experiment-records.integration.js",
    "check": "npm run build && node --check dist/src/server.js",
    "release:source": "node scripts/release/export-source.mjs",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "typecheck:backend": "tsc -p tsconfig.backend.check.json",
    "lint:frontend": "eslint --config frontend/eslint.config.js frontend --max-warnings=0",
    "lint:backend": "eslint --config eslint.backend.config.js src/domain/agents src/domain/research/review-policy.ts src/http/streams.ts src/services/agents/agent-attachment-service.ts src/services/agents/agent-image-service.ts src/services/agents/agent-history-store.ts src/services/agents/agent-session-persistence.ts src/services/agents/session-checkpoint.ts src/services/agents/agent-candidate-turns.ts src/services/agents/approval-policy.ts src/adapters/agents/shared/prompt-images.ts src/domain/research/experiment-records.ts src/domain/research/interfaces/schema-output.ts src/services/research/experiments src/services/research/changes/experiment-mutations.ts --max-warnings=0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opencode-ai/sdk": "1.19.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.4",
    "elkjs": "^0.11.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "bin": {
    "topolumia": "bin/topolumia"
  }
}
